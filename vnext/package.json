    "check:types": "node scripts/types.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@playwright/test": "^1.58.0",
    "esbuild": "^0.27.0",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "@tailwindcss/vite": "4.3.2",
    "tailwindcss": "4.3.2"
  }
}
